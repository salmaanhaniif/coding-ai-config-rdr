{
  "name": "coding-ai-config-rdr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "db:init": "tsx server/migrate.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server shared scripts tests *.ts *.json README.md HANDOFF_A_TO_B.md docs/*.md",
    "demo:expert": "tsx scripts/expert-demo.ts",
    "dev:expert": "tsx scripts/dev-expert.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
